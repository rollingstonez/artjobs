# 복사해서 .env.local 로 저장 (.env.local 은 커밋되지 않는다)
# 두 값이 비어 있으면 회원 기능은 "준비 중"으로 보이고 공고는 샘플로 돈다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 크롤러 전용 — 브라우저에 절대 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
# 소셜 로그인 버튼. Supabase Authentication > Providers 에서 켠 것만 쉼표로 적는다 (google,kakao,apple).
# 비워 두면 이메일 가입만 보인다. 설정 순서는 docs/SOCIAL_LOGIN.md
NEXT_PUBLIC_AUTH_PROVIDERS=

# 복사해서 .env.local 로 저장 (.env.local 은 커밋되지 않는다)
# 두 값이 비어 있으면 회원 기능은 "준비 중"으로 보이고 공고는 샘플로 돈다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 크롤러 전용 — 브라우저에 절대 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
# 소셜 로그인 버튼(카카오·구글·애플)은 항상 보이고, Supabase 에서 켠 제공자를 자동으로 알아낸다.
# 이 값은 선택 사항 — 적으면 그 제공자를 켜진 것으로 강제한다 (google,kakao,apple). 설정 순서는 docs/SOCIAL_LOGIN.md
NEXT_PUBLIC_AUTH_PROVIDERS=
